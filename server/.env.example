# development | production | test
NODE_ENV=development
PORT=4000
# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ishhaqqi?schema=public
# Long random string (min 32 chars). Generate: openssl rand -hex 32
JWT_SECRET=
# Comma-separated list of allowed frontend origins (exact match)
CORS_ORIGIN=http://localhost:5173
# lax when frontend & API share a site (e.g. Vercel rewrite), none for cross-site (requires HTTPS)
COOKIE_SAMESITE=lax
# Session length in hours
SESSION_HOURS=12
# Optional: creates the first admin on startup ONLY if no user exists yet.
# Remove these after the first successful start.
ADMIN_USERNAME=
ADMIN_PASSWORD=
